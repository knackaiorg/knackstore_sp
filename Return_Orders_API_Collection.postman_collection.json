                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/return-orders/admin/refunded",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "return-orders",
                "admin",
                "refunded"
              ]
            },
            "description": "Get all refunded return orders - ADMIN ENDPOINT"
          },
          "response": []
        },
        {
          "name": "Process Refunds for All Eligible Returns",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refunds processed successfully', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/return-orders/admin/process-refunds",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "return-orders",
                "admin",
                "process-refunds"
              ]
            },
            "description": "Process refunds for all eligible return orders - ADMIN ENDPOINT\n\nThis endpoint:\n1. Finds all COMPLETED returns with items received\n2. Updates their status to REFUNDED\n3. Records processing timestamps\n4. Returns summary of processed refunds"
          },
          "response": []
        },
        {
          "name": "Process Refund for Specific Return",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refund processed successfully for specific return', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal('REFUNDED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/return-orders/{{returnCode}}/process-refund",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "return-orders",
                "{{returnCode}}",
                "process-refund"
              ]
            },
            "description": "Process refund for a specific return order - ADMIN ENDPOINT"
          },
          "response": []
        }
      ]
